# jira-tui configuration.
#
#   cp .env.example .env && $EDITOR .env && source .env && jira-tui
#
# Or export these however you normally manage environment variables
# (direnv, your shell profile, a secrets manager).

# --- Required -------------------------------------------------------------

# Your Jira base URL, with no trailing slash and no /jira path unless your
# instance is actually served from one.
export JIRA_URL=https://your-domain.atlassian.net

# The email address of the Jira account the API token belongs to.
export JIRA_EMAIL=you@example.com

# An API token, NOT your password. Create one at:
# https://id.atlassian.com/manage-profile/security/api-tokens
export JIRA_TOKEN=your-api-token

# --- Optional: Tempo time tracking ---------------------------------------
#
# Tempo is a paid Jira add-on. Leave these unset if you do not use it:
# jira-tui runs without them and simply hides the worklog features
# (the LOGGED column, the "Total Logged" panel line, and the `w` keybind).

# export TEMPO_URL=https://api.tempo.io
# export TEMPO_TOKEN=your-tempo-token
